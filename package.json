{
  "name": "grpc",
  "private": true,
  "license": "BSD 3-Clause",
  "type": "module",
  "workspaces": [
    "packages/**/*",
    "!packages/**/proto"
  ],
  "lint-staged": {
    "*.{yml,yaml,json,graphql,md}": "yarn format",
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "yarn format",
      "yarn lint"
    ],
    "*.{test,spec}.{ts,tsx}": "yarn test unit"
  },
  "devDependencies": {
    "@atls/raijin": "1.1.1",
    "@types/node": "22.20.0"
  },
  "dependenciesMeta": {
    "@grpc/grpc-js@1.5.5": {
      "unplugged": true
    },
    "grpc_tools_node_protoc_ts@5.2.2": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.18.0",
  "linterIgnorePatterns": [
    "**/*/proto/**/*.js"
  ]
}
